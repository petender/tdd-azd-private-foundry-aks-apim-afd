@page
@model IndexModel
@{
    ViewData["Title"] = "Chat";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">AI Chat</h5>
                @if (!string.IsNullOrEmpty(Model.Session.ThreadId))
                {
                    <span class="badge bg-secondary font-monospace" style="font-size:0.65rem">
                        thread: @Model.Session.ThreadId[..Math.Min(16, Model.Session.ThreadId.Length)]&hellip;
                    </span>
                }
            </div>

            <div class="card-body" id="chat-window" style="min-height:340px;max-height:520px;overflow-y:auto">
                @if (!Model.Session.Messages.Any())
                {
                    <p class="text-muted text-center mt-5">Send a message to start chatting.</p>
                }
                @foreach (var msg in Model.Session.Messages)
                {
                    if (msg.Role == "user")
                    {
                        <div class="d-flex justify-content-end mb-2">
                            <div class="bg-primary text-white rounded p-2 px-3" style="max-width:75%">
                                @msg.Content
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-start mb-2">
                            <div class="bg-light border rounded p-2 px-3" style="max-width:75%">
                                @msg.Content
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="card-footer">
                <form method="post">
                    <input type="hidden" asp-for="Session.ThreadId" />
                    <div class="input-group">
                        <input asp-for="UserInput" class="form-control" placeholder="Type a message&hellip;" autocomplete="off" />
                        <button class="btn btn-primary" type="submit">Send</button>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="text-danger small mt-1">@Model.ErrorMessage</div>
                    }
                </form>
            </div>
        </div>

        <div class="text-center mt-3">
            <a href="/" class="btn btn-outline-secondary btn-sm">New conversation</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var w = document.getElementById('chat-window');
        if (w) w.scrollTop = w.scrollHeight;
    </script>
}
